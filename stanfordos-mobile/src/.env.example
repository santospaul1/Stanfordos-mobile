EXPO_PUBLIC_API_URL=https://stanfordos.co.ke/api
EXPO_PUBLIC_APP_NAME=Stanfordos
EXPO_PUBLIC_ENVIRONMENT=development

# true = demo accounts / mock modules (default for UI work)
# false = hit real Spring Boot auth (needs MOB-BE-01 for safe multi-tenant)
EXPO_PUBLIC_USE_MOCK_AUTH=true
EXPO_PUBLIC_USE_MOCK_DATA=true
