{
  "expo": {
    "name": "Stanfordos",
    "slug": "stanfordos-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "stanfordos",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ke.co.stanfordos.mobile"
    },
    "android": {
      "package": "ke.co.stanfordos.mobile",
      "edgeToEdgeEnabled": true
    },
    "plugins": ["expo-router", "expo-secure-store", "expo-notifications"],
    "experiments": {
      "typedRoutes": true
    }
  }
}
